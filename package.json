{
  "name": "sahaaya-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:custom-client\"",
    "dev:custom-client": "vite",
    "dev:server": "ts-node server/index.ts",
    "build": "vite build",
    "preview": "vite preview",
    "db:init": "prisma init --datasource-provider sqlite",
    "db:migrate": "prisma migrate dev --name init",
    "db:seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "framer-motion": "^10.12.16",
    "i18next": "^23.0.1",
    "lucide-react": "^0.268.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^13.0.2",
    "react-router-dom": "^6.14.1",
    "recharts": "^2.6.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^20.6.0",
    "@types/react": "^18.2.21",
    "@types/react-dom": "^18.2.7",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.14",
    "concurrently": "^9.1.0",
    "postcss": "^8.4.30",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.17",
    "ts-node": "^10.9.2",
    "typescript": "^5.2.2",
    "vite": "^5.1.0"
  }
}