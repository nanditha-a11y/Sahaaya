<file path="frontend/src/api/client.ts">
export interface Child {
  id: string
  name: string
  age: number
  education: string
  health: string
  photo: string
}

export interface Message {
  id: string
  from: string
  role: string
  text: string
  date: string
}

export interface DashboardStats {
  children: number
  donations: {
    count: number
    total: number
  }
  resources: {
    count: number
    totalStock: number
  }
  messages: number
}

export type NewChild = Omit<Child, 'id'>

const configuredApiBaseUrl = (import.meta as ImportMeta & {
  env?: Record<string, string | undefined>
}).env?.VITE_API_BASE_URL
const apiBaseUrl = configuredApiBaseUrl ?? '/api'

class ApiResponseError extends Error {
  constructor(readonly status: number, message: string) {
    super(message)
    this.name = 'ApiResponseError'
  }
}

async function request<T>(path: string, init?: RequestInit): Promise<T> {
  const response = await fetch(`${apiBaseUrl}${path}`, {
    ...init,
    headers: {
      'Content-Type': 'application/json',
      ...init?.headers
    }
  })

  if (!response.ok) {
    throw new ApiResponseError(
      response.status,
      `API request failed (${response.status} ${response.statusText})`
    )
  }

  return response.json() as Promise<T>
}

export async function getDashboardStats(fallback: DashboardStats): Promise<DashboardStats> {
  try {
    return await request<DashboardStats>('/dashboard/stats')
  } catch (error) {
    console.warn('Using mock dashboard statistics because the API is unavailable.', error)
    return fallback
  }
}

export async function getChildren(fallback: Child[]): Promise<Child[]> {
  try {
    return await request<Child[]>('/children')
  } catch (error) {
    console.warn('Using mock children because the API is unavailable.', error)
    return fallback
  }
}

export async function createChild(child: NewChild): Promise<Child> {
  try {
    return await request<Child>('/children', {
      method: 'POST',
      body: JSON.stringify(child)
    })
  } catch (error) {
    if (error instanceof ApiResponseError && error.status < 500) throw error
    console.warn('Keeping the new child in local page state because the API is unavailable.', error)
    return {
      ...child,
      id: `local-${Date.now()}`
    }
  }
}

export async function getMessages(fallback: Message[]): Promise<Message[]> {
  try {
    const messages = await request<Message[]>('/messages')
    return messages.map(message => ({
      ...message,
      date: message.date.slice(0, 10)
    }))
  } catch (error) {
    console.warn('Using mock messages because the API is unavailable.', error)
    return fallback
  }
}
