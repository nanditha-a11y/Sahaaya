import React, { useEffect, useState } from 'react'
import Card from '../components/Card'
import {
  Child,
  MentorItem,
  MentorshipSessionItem,
  createMentorshipSession,
  getChildren,
  getMentorshipOverview,
} from '../api/client'
import { useRole } from '../contexts/RoleContext'

export default function Mentorship() {
  const { dbRole } = useRole()
  const canSchedule =
    dbRole === 'SUPER_ADMIN' || dbRole === 'STAFF' || dbRole === 'EDUCATOR'

  const [mentors, setMentors] = useState<MentorItem[]>([])
  const [sessions, setSessions] = useState<MentorshipSessionItem[]>([])
  const [children, setChildren] = useState<Child[]>([])
  const [showForm, setShowForm] = useState(false)
  const [saving, setSaving] = useState(false)
  const [feedback, setFeedback] = useState('')

  const loadMentorship = async () => {
    try {
      const data = await getMentorshipOverview()
      setMentors(data.mentors)
      setSessions(data.sessions)
    } catch (err: any) {
      setFeedback(err.message || 'Unable to load mentorship data.')
    }
  }

  useEffect(() => {
    void loadMentorship()
    if (canSchedule) {
      void getChildren([]).then(setChildren)
    }
  }, [canSchedule])

  const handleSchedule = async (e: React.FormEvent<HTMLFormElement>) => {
    e.preventDefault()
    const fd = new FormData(e.currentTarget)
    setSaving(true)
    setFeedback('')
    try {
      await createMentorshipSession({
        mentorId: String(fd.get('mentorId')),
        childId: String(fd.get('childId')),
        topic: String(fd.get('topic')),
        sessionDate: String(fd.get('sessionDate')),
        durationMin: Number(fd.get('durationMin') || 45),
        notes: String(fd.get('notes') || '').trim() || undefined,
      })
      e.currentTarget.reset()
      setShowForm(false)
      setFeedback('Mentorship session scheduled.')
      await loadMentorship()
    } catch (err: any) {
      setFeedback(err.message || 'Could not schedule session.')
    } finally {
      setSaving(false)
    }
  }

  return (
    <div className="space-y-6">
      <div className="flex flex-wrap items-center justify-between gap-3">
        <h2 className="text-2xl handwritten" style={{ color: '#6b4c3b' }}>
          Mentorship &amp; Guidance
        </h2>
        {canSchedule && (
          <button
            type="button"
            onClick={() => setShowForm((s) => !s)}
            className="btn-primary handwritten text-sm"
          >
            {showForm ? 'Close' : '+ Schedule Session'}
          </button>
        )}
      </div>

      {feedback && (
        <div className="glass-card rounded-lg px-4 py-2 text-sm handwritten" style={{ color: '#4b3628' }}>
          {feedback}
        </div>
      )}

      {canSchedule && showForm && (
        <Card className="p-4">
          <form onSubmit={handleSchedule} className="grid grid-cols-1 sm:grid-cols-3 gap-3 text-sm">
            <select
              name="mentorId"
              required
              className="rounded-lg border border-[#6b4c3b]/20 bg-[#fffdf7] p-2"
            >
              <option value="">Select mentor…</option>
              {mentors.map((m) => (
                <option key={m.id} value={m.id}>
                  {m.name} ({m.specialty})
                </option>
              ))}
            </select>
            <select
              name="childId"
              required
              className="rounded-lg border border-[#6b4c3b]/20 bg-[#fffdf7] p-2"
            >
              <option value="">Select student…</option>
              {children.map((c) => (
                <option key={c.id} value={c.id}>
                  {c.name}
                </option>
              ))}
            </select>
            <input
              name="topic"
              placeholder="Session topic (e.g. STEM Career Prep)"
              required
              className="rounded-lg border border-[#6b4c3b]/20 bg-[#fffdf7] p-2"
            />
            <input
              name="sessionDate"
              type="date"
              required
              className="rounded-lg border border-[#6b4c3b]/20 bg-[#fffdf7] p-2"
            />
            <input
              name="durationMin"
              type="number"
              min="15"
              max="180"
              defaultValue={45}
              className="rounded-lg border border-[#6b4c3b]/20 bg-[#fffdf7] p-2"
            />
            <button type="submit" disabled={saving} className="btn-primary handwritten">
              {saving ? 'Scheduling…' : 'Confirm Session'}
            </button>
          </form>
        </Card>
      )}

      <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {mentors.map((m) => (
          <Card key={m.id} className="p-4">
            <div className="handwritten font-semibold text-lg" style={{ color: '#4b3628' }}>
              {m.name}
            </div>
            <div className="text-xs vintage-badge inline-block mt-1" style={{ color: '#4b3628' }}>
              {m.specialty}
            </div>
            {m.bio && (
              <p className="text-sm mt-2" style={{ color: '#5a4433' }}>
                {m.bio}
              </p>
            )}
            <div className="text-xs mt-2" style={{ color: '#6b4c3b' }}>
              {m.city ? `${m.city} · ` : ''}
              {m._count.sessions} sessions completed
            </div>
          </Card>
        ))}
      </div>

      {sessions.length > 0 && (
        <div className="glass-card p-4 rounded-xl paper-edge">
          <div className="handwritten font-semibold text-lg" style={{ color: '#6b4c3b' }}>
            Recent &amp; Upcoming Mentorship Sessions
          </div>
          <ul className="mt-3 space-y-2 text-sm" style={{ color: '#5a4433' }}>
            {sessions.slice(0, 10).map((s) => (
              <li key={s.id} className="border-b border-[#6b4c3b]/10 pb-1.5">
                <span className="font-semibold">{s.topic}</span> — {s.child.name} with{' '}
                {s.mentor.name} ({s.sessionDate.slice(0, 10)}, {s.durationMin} min)
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>
  )
}
