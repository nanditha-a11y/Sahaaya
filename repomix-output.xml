<file path="frontend/src/pages/auth/AuthPage.tsx">
import React, { FormEvent, useState } from 'react'
import { Link, Navigate, useNavigate, useParams } from 'react-router-dom'
import { motion } from 'framer-motion'
import { Role, useRole } from '../../contexts/RoleContext'

type AuthMode = 'login' | 'register'

const roleLabels: Record<Role, string> = {
  admin: 'Admin',
  student: 'Student',
  donor: 'Donor'
}

const isRole = (value: string | undefined): value is Role =>
  value === 'admin' || value === 'student' || value === 'donor'

export default function AuthPage({ mode }: { mode: AuthMode }) {
  const { role: roleParam } = useParams()
  const navigate = useNavigate()
  const { setRole } = useRole()
  const [error, setError] = useState('')

  if (!isRole(roleParam)) return <Navigate to="/" replace />

  const role = roleParam
  const isRegistration = mode === 'register'

  const submit = (event: FormEvent<HTMLFormElement>) => {
    event.preventDefault()
    setError('')

    const formData = new FormData(event.currentTarget)
    const password = String(formData.get('password') ?? '')

    if (password.length < 8 || !/[a-z]/.test(password) || !/[A-Z]/.test(password) || !/\d/.test(password)) {
      setError('Use at least 8 characters, including an uppercase letter, lowercase letter, and number.')
      return
    }

    if (isRegistration) {
      const name = String(formData.get('name') ?? '').trim()
      const confirmation = String(formData.get('confirmPassword') ?? '')
      if (name.length < 2) {
        setError('Enter a name with at least 2 characters.')
        return
      }
      if (password !== confirmation) {
        setError('Passwords do not match.')
        return
      }
    }

    setRole(role)
    navigate(`/${role}`, { replace: true })
  }

  const alternatePath = `/${isRegistration ? 'login' : 'register'}/${role}`

  return (
    <motion.section
      initial={{ opacity: 0, y: 12 }}
      animate={{ opacity: 1, y: 0 }}
      className="max-w-xl mx-auto"
    >
      <div className="glass-card paper-edge rounded-2xl p-6 sm:p-8">
        <div className="text-center mb-6">
          <h1 className="handwritten text-3xl" style={{ color: '#6b4c3b' }}>
            {roleLabels[role]} {isRegistration ? 'Registration' : 'Login'}
          </h1>
          <p className="text-sm mt-2" style={{ color: '#4b3628' }}>
            {isRegistration
              ? `Create your ${roleLabels[role].toLowerCase()} portal profile.`
              : `Continue to the ${roleLabels[role].toLowerCase()} portal.`}
          </p>
        </div>

        <form className="space-y-4" onSubmit={submit}>
          {isRegistration && (
            <label className="block text-sm" style={{ color: '#4b3628' }}>
              Full name
              <input
                name="name"
                type="text"
                autoComplete="name"
                minLength={2}
                required
                className="mt-1 w-full rounded-lg border border-[#6b4c3b]/20 bg-[#fffdf7] p-3 outline-none focus:border-[#6b4c3b]"
              />
            </label>
          )}

          <label className="block text-sm" style={{ color: '#4b3628' }}>
            Email address
            <input
              name="email"
              type="email"
              autoComplete="email"
              required
              className="mt-1 w-full rounded-lg border border-[#6b4c3b]/20 bg-[#fffdf7] p-3 outline-none focus:border-[#6b4c3b]"
            />
          </label>

          <label className="block text-sm" style={{ color: '#4b3628' }}>
            Password
            <input
              name="password"
              type="password"
              autoComplete={isRegistration ? 'new-password' : 'current-password'}
              minLength={8}
              required
              className="mt-1 w-full rounded-lg border border-[#6b4c3b]/20 bg-[#fffdf7] p-3 outline-none focus:border-[#6b4c3b]"
            />
          </label>

          {isRegistration && (
            <label className="block text-sm" style={{ color: '#4b3628' }}>
              Confirm password
              <input
                name="confirmPassword"
                type="password"
                autoComplete="new-password"
                minLength={8}
                required
                className="mt-1 w-full rounded-lg border border-[#6b4c3b]/20 bg-[#fffdf7] p-3 outline-none focus:border-[#6b4c3b]"
              />
            </label>
          )}

          {error && (
            <p role="alert" className="rounded-lg border border-red-800/20 bg-red-50 p-3 text-sm text-red-900">
              {error}
            </p>
          )}

          <button type="submit" className="btn-primary handwritten w-full text-lg">
            {isRegistration ? 'Create account' : 'Continue'}
          </button>
        </form>

        <p className="mt-5 text-center text-sm" style={{ color: '#4b3628' }}>
          {isRegistration ? 'Already registered?' : 'New to Sahaaya?'}{' '}
          <Link className="font-semibold underline" style={{ color: '#6b4c3b' }} to={alternatePath}>
            {isRegistration ? 'Login' : 'Create an account'}
          </Link>
        </p>
        <p className="mt-3 text-center text-xs" style={{ color: '#7a5a44' }}>
          Demo portal access is stored on this device.
        </p>
      </div>
    </motion.section>
  )
}
</file>

