<file path="frontend/src/pages/Donors.tsx">
import React, { useEffect, useState } from 'react'
import Card from '../components/Card'
import { DonorsOverview, createDonation, getDonorsOverview } from '../api/client'
import { useRole } from '../contexts/RoleContext'

export default function Donors() {
  const { dbRole, profile } = useRole()
  const canDonate =
    dbRole === 'DONOR' || dbRole === 'SUPER_ADMIN' || dbRole === 'STAFF'

  const [overview, setOverview] = useState<DonorsOverview>({
    donors: [],
    campaigns: [],
    myDonations: [],
  })
  const [showForm, setShowForm] = useState(false)
  const [saving, setSaving] = useState(false)
  const [feedback, setFeedback] = useState('')

  const loadDonors = async () => {
    try {
      const data = await getDonorsOverview()
      setOverview(data)
    } catch (err: any) {
      setFeedback(err.message || 'Unable to load donor records.')
    }
  }

  useEffect(() => {
    void loadDonors()
  }, [])

  const handleDonate = async (e: React.FormEvent<HTMLFormElement>) => {
    e.preventDefault()
    const fd = new FormData(e.currentTarget)
    const amount = Number(fd.get('amount') || 0)
    if (amount <= 0) return

    setSaving(true)
    setFeedback('')
    try {
      const campaignId = String(fd.get('campaignId') || '').trim() || undefined
      const donorName = String(fd.get('donorName') || '').trim() || profile?.name
      const donorEmail = String(fd.get('donorEmail') || '').trim() || profile?.email
      const isAnonymous = fd.get('isAnonymous') === 'on'

      await createDonation({
        amount,
        campaignId,
        donorName,
        donorEmail,
        isAnonymous,
      })
      e.currentTarget.reset()
      setShowForm(false)
      setFeedback(`Thank you! Contribution of ₹${amount.toLocaleString('en-IN')} recorded.`)
      await loadDonors()
    } catch (err: any) {
      setFeedback(err.message || 'Failed to record donation.')
    } finally {
      setSaving(false)
    }
  }

  return (
    <div className="space-y-6">
      <div className="flex flex-wrap items-center justify-between gap-3">
        <h2 className="text-2xl handwritten" style={{ color: '#6b4c3b' }}>
          Donor Transparency
        </h2>
        {canDonate && (
          <button
            type="button"
            onClick={() => setShowForm((s) => !s)}
            className="btn-primary handwritten text-sm"
          >
            {showForm ? 'Close' : dbRole === 'DONOR' ? '+ Make a Contribution' : '+ Record Donation'}
          </button>
        )}
      </div>

      {feedback && (
        <div className="glass-card rounded-lg px-4 py-2 text-sm handwritten" style={{ color: '#4b3628' }}>
          {feedback}
        </div>
      )}

      {canDonate && showForm && (
        <Card className="p-4">
          <form onSubmit={handleDonate} className="grid grid-cols-1 sm:grid-cols-3 gap-3 text-sm">
            <input
              name="amount"
              type="number"
              min="100"
              step="100"
              placeholder="Amount (₹)"
              required
              className="rounded-lg border border-[#6b4c3b]/20 bg-[#fffdf7] p-2"
            />
            <select
              name="campaignId"
              className="rounded-lg border border-[#6b4c3b]/20 bg-[#fffdf7] p-2"
            >
              <option value="">General Child Welfare Fund</option>
              {overview.campaigns.map((c) => (
                <option key={c.id} value={c.id}>
                  {c.title}
                </option>
              ))}
            </select>
            {dbRole !== 'DONOR' && (
              <>
                <input
                  name="donorName"
                  placeholder="Donor Name"
                  required
                  className="rounded-lg border border-[#6b4c3b]/20 bg-[#fffdf7] p-2"
                />
                <input
                  name="donorEmail"
                  type="email"
                  placeholder="Donor Email"
                  required
                  className="rounded-lg border border-[#6b4c3b]/20 bg-[#fffdf7] p-2"
                />
              </>
            )}
            <label className="flex items-center gap-2 text-xs" style={{ color: '#4b3628' }}>
              <input name="isAnonymous" type="checkbox" />
              List publicly as Anonymous
            </label>
            <button type="submit" disabled={saving} className="btn-primary handwritten">
              {saving ? 'Recording…' : 'Confirm Contribution'}
            </button>
          </form>
        </Card>
      )}

      {overview.campaigns.length > 0 && (
        <div className="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {overview.campaigns.map((c) => (
            <div key={c.id} className="glass-card p-4 rounded-xl paper-edge">
              <div className="flex justify-between items-center">
                <div className="handwritten font-semibold" style={{ color: '#4b3628' }}>
                  {c.title}
                </div>
                <span className="text-xs vintage-badge" style={{ color: '#4b3628' }}>
                  {c.progressPercent}%
                </span>
              </div>
              <p className="text-xs mt-1" style={{ color: '#6b4c3b' }}>
                {c.description}
              </p>
              <div className="mt-2 text-xs" style={{ color: '#5a4433' }}>
                Raised: ₹{c.raisedAmount.toLocaleString('en-IN')} / ₹
                {c.targetAmount.toLocaleString('en-IN')}
              </div>
              <div
                className="w-full bg-[#fff8ef] h-2 rounded mt-2 overflow-hidden"
                style={{ border: '1px solid rgba(75,54,40,0.06)' }}
              >
                <div
                  style={{
                    width: `${c.progressPercent}%`,
                    height: '100%',
                    background: '#c69b6d',
                  }}
                />
              </div>
            </div>
          ))}
        </div>
      )}

      <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {overview.donors.map((d) => (
          <Card key={d.id} className="p-4">
            <div className="handwritten font-semibold">{d.name}</div>
            <div className="text-sm mt-2" style={{ color: '#5a4433' }}>
              Total Given: ₹{d.total.toLocaleString('en-IN')}
            </div>
            <div className="text-xs mt-1" style={{ color: '#6b4c3b' }}>
              {d.city ? `${d.city} · ` : ''}
              {d.donationCount} {d.donationCount === 1 ? 'contribution' : 'contributions'}
              {d.isRecurring ? ' · Monthly Sponsor' : ''}
            </div>
          </Card>
        ))}
      </div>
    </div>
  )
}
</file>

<file path="frontend/src/pages/Education.tsx">
import React, { useEffect, useState } from 'react'
import Card from '../components/Card'
import { LineChart, Line, XAxis, YAxis, Tooltip, ResponsiveContainer } from 'recharts'
import {
  Child,
  EducationOverview,
  createEducationRecord,
  getChildren,
  getEducationOverview,
  logAttendance,
} from '../api/client'
import { useRole } from '../contexts/RoleContext'

const fallbackTrend = [
  { month: 'Jan', score: 65 },
  { month: 'Feb', score: 68 },
  { month: 'Mar', score: 70 },
  { month: 'Apr', score: 74 },
  { month: 'May', score: 78 },
  { month: 'Jun', score: 82 },
]

export default function Education() {
  const { dbRole } = useRole()
  const canEdit = dbRole === 'SUPER_ADMIN' || dbRole === 'STAFF' || dbRole === 'EDUCATOR'

  const [children, setChildren] = useState<Child[]>([])
  const [selectedChildId, setSelectedChildId] = useState<string>('')
  const [overview, setOverview] = useState<EducationOverview>({
    records: [],
    trend: fallbackTrend,
    attendanceSummary: { total: 0, present: 0, rate: 92 },
  })
  const [showRecordForm, setShowRecordForm] = useState(false)
  const [saving, setSaving] = useState(false)
  const [feedback, setFeedback] = useState('')

  const loadEducation = async (childId?: string) => {
    try {
      const data = await getEducationOverview(childId || undefined)
      setOverview({
        ...data,
        trend: data.trend.length > 0 ? data.trend : fallbackTrend,
      })
    } catch (err) {
      console.warn('Could not load live education records:', err)
    }
  }

  useEffect(() => {
    void getChildren([]).then((list) => {
      setChildren(list)
      if (dbRole === 'STUDENT' && list.length === 1) {
        setSelectedChildId(list[0].id)
      }
    })
  }, [dbRole])

  useEffect(() => {
    void loadEducation(selectedChildId)
  }, [selectedChildId])

  const handleAddRecord = async (e: React.FormEvent<HTMLFormElement>) => {
    e.preventDefault()
    const fd = new FormData(e.currentTarget)
    const childId = String(fd.get('childId') || selectedChildId)
    if (!childId) return

    setSaving(true)
    setFeedback('')
    try {
      await createEducationRecord({
        childId,
        schoolName: String(fd.get('schoolName') || 'Sahaaya Vidya Mandir'),
        grade: String(fd.get('grade') || 'Grade 6'),
        academicYear: String(fd.get('academicYear') || '2026-2027'),
        term: String(fd.get('term') || 'Term 1'),
        gpaOrScore: Number(fd.get('gpaOrScore') || 80),
        notes: String(fd.get('notes') || '').trim() || undefined,
      })
      e.currentTarget.reset()
      setShowRecordForm(false)
      setFeedback('Academic record saved.')
      await loadEducation(selectedChildId)
    } catch (err: any) {
      setFeedback(err.message || 'Failed to save academic record.')
    } finally {
      setSaving(false)
    }
  }

  const handleQuickAttendance = async (status: 'PRESENT' | 'ABSENT' | 'LATE') => {
    if (!selectedChildId) {
      setFeedback('Select a student first to mark today’s attendance.')
      return
    }
    try {
      await logAttendance({ childId: selectedChildId, status })
      setFeedback(`Marked ${status.toLowerCase()} for today.`)
      await loadEducation(selectedChildId)
    } catch (err: any) {
      setFeedback(err.message || 'Could not log attendance.')
    }
  }

  return (
    <div className="space-y-6">
      <div className="flex flex-wrap items-center justify-between gap-3">
        <h2 className="text-2xl handwritten" style={{ color: '#6b4c3b' }}>
          Education Tracking
        </h2>
        <div className="flex flex-wrap items-center gap-3">
          {children.length > 0 && (
            <select
              value={selectedChildId}
              onChange={(e) => setSelectedChildId(e.target.value)}
              className="rounded-lg border border-[#6b4c3b]/20 bg-[#fffdf7] px-3 py-1.5 text-sm handwritten"
              style={{ color: '#4b3628' }}
            >
              <option value="">All Students</option>
              {children.map((c) => (
                <option key={c.id} value={c.id}>
                  {c.name} ({c.education})
                </option>
              ))}
            </select>
          )}
          {canEdit && (
            <button
              type="button"
              onClick={() => setShowRecordForm((s) => !s)}
              className="btn-primary handwritten text-sm"
            >
              {showRecordForm ? 'Close Form' : '+ Log Score'}
            </button>
          )}
        </div>
      </div>

      {feedback && (
        <div className="glass-card rounded-lg px-4 py-2 text-sm handwritten" style={{ color: '#4b3628' }}>
          {feedback}
        </div>
      )}

      {canEdit && showRecordForm && (
        <Card className="p-4">
          <form onSubmit={handleAddRecord} className="grid grid-cols-1 sm:grid-cols-3 gap-3 text-sm">
            <select
              name="childId"
              defaultValue={selectedChildId}
              required
              className="rounded-lg border border-[#6b4c3b]/20 bg-[#fffdf7] p-2"
            >
              <option value="">Select student…</option>
              {children.map((c) => (
                <option key={c.id} value={c.id}>
                  {c.name}
                </option>
              ))}
            </select>
            <input
              name="schoolName"
              placeholder="School Name"
              defaultValue="Sahaaya Vidya Mandir"
              required
              className="rounded-lg border border-[#6b4c3b]/20 bg-[#fffdf7] p-2"
            />
            <input
              name="grade"
              placeholder="Grade (e.g. Grade 6)"
              required
              className="rounded-lg border border-[#6b4c3b]/20 bg-[#fffdf7] p-2"
            />
            <input
              name="academicYear"
              placeholder="2026-2027"
              defaultValue="2026-2027"
              required
              className="rounded-lg border border-[#6b4c3b]/20 bg-[#fffdf7] p-2"
            />
            <input
              name="term"
              placeholder="Term (e.g. Term 1)"
              defaultValue="Term 1"
              required
              className="rounded-lg border border-[#6b4c3b]/20 bg-[#fffdf7] p-2"
            />
            <input
              name="gpaOrScore"
              type="number"
              step="0.1"
              min="0"
              max="100"
              placeholder="Score (%)"
              required
              className="rounded-lg border border-[#6b4c3b]/20 bg-[#fffdf7] p-2"
            />
            <input
              name="notes"
              placeholder="Teacher notes (optional)"
              className="sm:col-span-2 rounded-lg border border-[#6b4c3b]/20 bg-[#fffdf7] p-2"
            />
            <button type="submit" disabled={saving} className="btn-primary handwritten">
              {saving ? 'Saving…' : 'Save Academic Record'}
            </button>
          </form>
        </Card>
      )}

      <div className="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <Card className="p-4">
          <div className="flex items-center justify-between">
            <div className="handwritten font-semibold">Attendance &amp; Scores</div>
            <div className="text-xs vintage-badge" style={{ color: '#4b3628' }}>
              Attendance: {overview.attendanceSummary.rate}% ({overview.attendanceSummary.present}/
              {overview.attendanceSummary.total})
            </div>
          </div>
          {canEdit && selectedChildId && (
            <div className="mt-2 flex items-center gap-2 text-xs">
              <span style={{ color: '#6b4c3b' }}>Mark today:</span>
              {(['PRESENT', 'LATE', 'ABSENT'] as const).map((st) => (
                <button
                  key={st}
                  type="button"
                  onClick={() => void handleQuickAttendance(st)}
                  className="rounded border border-[#6b4c3b]/25 bg-[#fffdf7] px-2 py-0.5 hover:bg-[#efe0d0]"
                >
                  {st}
                </button>
              ))}
            </div>
          )}
          <div className="h-64 mt-4">
            <ResponsiveContainer width="100%" height="100%">
              <LineChart data={overview.trend}>
                <XAxis dataKey="month" stroke="#7a5a44" />
                <YAxis stroke="#7a5a44" />
                <Tooltip />
                <Line dataKey="score" stroke="#2f6b4a" strokeWidth={3} />
              </LineChart>
            </ResponsiveContainer>
          </div>
        </Card>

        <Card className="p-4">
          <div className="handwritten font-semibold">Academic Evaluations &amp; Milestones</div>
          {overview.records.length > 0 ? (
            <ul className="mt-3 space-y-2 text-sm max-h-64 overflow-y-auto" style={{ color: '#5a4433' }}>
              {overview.records.slice(0, 12).map((rec) => (
                <li key={rec.id} className="border-b border-[#6b4c3b]/10 pb-1.5">
                  <span className="font-semibold">{rec.child?.name ?? 'Student'}</span> — {rec.grade} (
                  {rec.term}, {rec.academicYear}):{' '}
                  <span className="font-semibold">{rec.gpaOrScore}%</span>
                  {rec.notes ? ` · ${rec.notes}` : ''}
                </li>
              ))}
            </ul>
          ) : (
            <ul className="mt-3 text-sm" style={{ color: '#5a4433' }}>
              <li>• Foundation Literacy Program — Completed</li>
              <li>• Basic Computer Course — In Progress</li>
              <li>• Mathematics Enrichment — Completed</li>
            </ul>
          )}
        </Card>
      </div>
    </div>
  )
}
</file>

<file path="frontend/src/pages/Health.tsx">
import React, { useEffect, useState } from 'react'
import Card from '../components/Card'
import WellnessRadar from '../modules/WellnessRadar'
import {
  Child,
  HealthRecordItem,
  createHealthRecord,
  getChildren,
  getHealthRecords,
} from '../api/client'
import { useRole } from '../contexts/RoleContext'

export default function Health() {
  const { dbRole } = useRole()
  const canAccessMedical = dbRole === 'SUPER_ADMIN' || dbRole === 'HEALTHCARE_STAFF'

  const [children, setChildren] = useState<Child[]>([])
  const [selectedChildId, setSelectedChildId] = useState<string>('')
  const [records, setRecords] = useState<HealthRecordItem[]>([])
  const [restrictedNotice, setRestrictedNotice] = useState<string>('')
  const [showForm, setShowForm] = useState(false)
  const [saving, setSaving] = useState(false)

  const loadRecords = async (childId?: string) => {
    if (!canAccessMedical) {
      setRestrictedNotice(
        'Detailed clinical records are restricted to Healthcare Staff and Super Admins.'
      )
      return
    }
    try {
      const rows = await getHealthRecords(childId || undefined)
      setRecords(rows)
      setRestrictedNotice('')
    } catch (err: any) {
      setRestrictedNotice(err.message || 'Unable to load confidential medical records.')
    }
  }

  useEffect(() => {
    if (canAccessMedical) {
      void getChildren([]).then(setChildren)
    }
  }, [canAccessMedical])

  useEffect(() => {
    void loadRecords(selectedChildId)
  }, [selectedChildId, canAccessMedical])

  const handleCreateCheckup = async (e: React.FormEvent<HTMLFormElement>) => {
    e.preventDefault()
    const fd = new FormData(e.currentTarget)
    const childId = String(fd.get('childId') || selectedChildId)
    if (!childId) return

    setSaving(true)
    try {
      const heightRaw = String(fd.get('heightCm') || '').trim()
      const weightRaw = String(fd.get('weightKg') || '').trim()
      const statusRaw = String(fd.get('healthStatusSummary') || '') as
        | 'Good'
        | 'Fair'
        | 'Needs Follow-up'
        | ''

      await createHealthRecord({
        childId,
        heightCm: heightRaw ? Number(heightRaw) : undefined,
        weightKg: weightRaw ? Number(weightRaw) : undefined,
        immunizationNotes: String(fd.get('immunizationNotes') || '').trim() || undefined,
        diagnosisOrNotes: String(fd.get('diagnosisOrNotes') || ''),
        healthStatusSummary: statusRaw || undefined,
      })
      e.currentTarget.reset()
      setShowForm(false)
      await loadRecords(selectedChildId)
    } finally {
      setSaving(false)
    }
  }

  return (
    <div className="space-y-6">
      <div className="flex flex-wrap items-center justify-between gap-3">
        <h2 className="text-2xl handwritten" style={{ color: '#6b4c3b' }}>
          Health &amp; Wellness
        </h2>
        {canAccessMedical && (
          <div className="flex flex-wrap items-center gap-3">
            <select
              value={selectedChildId}
              onChange={(e) => setSelectedChildId(e.target.value)}
              className="rounded-lg border border-[#6b4c3b]/20 bg-[#fffdf7] px-3 py-1.5 text-sm handwritten"
              style={{ color: '#4b3628' }}
            >
              <option value="">All Children</option>
              {children.map((c) => (
                <option key={c.id} value={c.id}>
                  {c.name} ({c.health})
                </option>
              ))}
            </select>
            <button
              type="button"
              onClick={() => setShowForm((s) => !s)}
              className="btn-primary handwritten text-sm"
            >
              {showForm ? 'Close Form' : '+ Record Checkup'}
            </button>
          </div>
        )}
      </div>

      {canAccessMedical && showForm && (
        <Card className="p-4">
