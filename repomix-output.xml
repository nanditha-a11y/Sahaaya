              <div className="w-full bg-[#fff8ef] h-2 rounded mt-2 overflow-hidden" style={{border:'1px solid rgba(75,54,40,0.06)'}}>
                <div style={{width:`${pct}%`, height:'100%', background:'#c69b6d'}} />
              </div>
            </div>
          )
        })}
      </div>

      {selected && (
        <div className="mt-4 p-4 glass-card rounded-xl">
