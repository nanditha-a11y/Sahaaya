import React, { useEffect, useState } from 'react'
import ProfileCard from '../../components/ProfileCard'
import ProgressCard from '../../components/ProgressCard'
import ChartCard from '../../components/ChartCard'
import ChildCard from '../../components/ChildCard'
import ActivityTimeline from '../../components/ActivityTimeline'
import VintageIllustration from '../../components/VintageIllustration'
import { useTranslation } from '../../i18n/useTranslation'
import { useRole } from '../../contexts/RoleContext'
import {
  EducationOverview,
  MentorshipSessionItem,
  ScholarshipItem,
  getChildren,
  getEducationOverview,
  getMentorshipOverview,
  getScholarships,
} from '../../api/client'

export default function StudentHome() {
  const { t } = useTranslation() as any
  const { profile } = useRole()
  const [student, setStudent] = useState({
    name: profile?.name || 'Meera',
    age: 10,
    education: 'Grade 5',
  })
  const [education, setEducation] = useState<EducationOverview | null>(null)
  const [sessions, setSessions] = useState<MentorshipSessionItem[]>([])
  const [scholarships, setScholarships] = useState<ScholarshipItem[]>([])

  useEffect(() => {
    let active = true

    getChildren([]).then((children) => {
      if (!active) return
      const match =
        children[0] ??
        children.find((c) => c.name.toLowerCase() === 'meera')
      if (match) {
        setStudent({
          name: match.name,
          age: match.age,
          education: match.education,
        })
        void getEducationOverview(match.id)
          .then((edu) => {
            if (active) setEducation(edu)
          })
          .catch(() => {})
      }
    })

    getMentorshipOverview()
      .then((data) => {
        if (active) setSessions(data.sessions)
      })
      .catch(() => {})

    getScholarships()
      .then((list) => {
        if (active) setScholarships(list)
      })
      .catch(() => {})

    return () => {
      active = false
    }
  }, [profile?.name])

  const attendancePercent = education?.attendanceSummary.rate ?? 68
  const latestScore = education?.records[0]?.gpaOrScore
  const latestSession = sessions[0]
  const appliedScholarship = scholarships.find((s) => s.applications.length > 0)

  const activities =
    sessions.length > 0
      ? sessions.slice(0, 3).map((s) => ({
          time: s.sessionDate.slice(0, 10),
          title: s.topic,
          desc: `Mentor: ${s.mentor.name}`,
        }))
      : [
          { time: 'Tomorrow', title: 'Math Class', desc: 'Practice times tables' },
          { time: 'Friday', title: 'Library Hour', desc: 'Read "The Little Prince"' },
        ]

  return (
    <div className="space-y-6">
      <div className="grid grid-cols-1 lg:grid-cols-3 gap-4 items-center">
        <div className="lg:col-span-2">
          <h2 className="text-2xl handwritten" style={{ color: '#6b4c3b' }}>
            {t('KeepLearning')}
          </h2>
          <div className="text-sm" style={{ color: '#4b3628' }}>
            {t('OverviewLine')}
          </div>
        </div>
        <div className="flex justify-end">
          <ProfileCard name={student.name} role={`Student · ${student.education}`} />
        </div>
      </div>

      <div className="mt-4">
        <VintageIllustration
          variant="student"
          title={t('KeepLearning')}
          description={t('EmpoweringTitle')}
        />
      </div>

      <div className="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <ProgressCard title="Attendance Rate" percent={attendancePercent} />
        <ChartCard title="Recent Grades">
          {education && education.records.length > 0 ? (
            <ul className="space-y-1 text-xs" style={{ color: '#4b3628' }}>
              {education.records.slice(0, 3).map((r) => (
                <li key={r.id}>
                  • {r.grade} ({r.term}): <strong>{r.gpaOrScore}%</strong>
                </li>
              ))}
            </ul>
          ) : (
            <div className="h-28 flex items-center justify-center text-slate-500">
              {latestScore ? `Latest Score: ${latestScore}%` : '[Grades chart]'}
            </div>
          )}
        </ChartCard>
        <div className="space-y-4">
          <ChildCard
            name={student.name}
            age={student.age}
            progress={latestScore ? Math.round(latestScore) : 68}
          />
          <ActivityTimeline events={activities} />
        </div>
      </div>

      <div className="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <ChartCard title="Mentor Messages">
          <div className="h-28 text-sm" style={{ color: '#4b3628' }}>
            {latestSession
              ? `Upcoming/Recent: "${latestSession.topic}" with ${latestSession.mentor.name} (${latestSession.sessionDate.slice(0, 10)}).`
              : 'You have a new message from Ms. Iyer.'}
          </div>
        </ChartCard>
        <ChartCard title="Scholarship Status">
          <div className="h-28 text-sm" style={{ color: '#4b3628' }}>
            {appliedScholarship
              ? `${appliedScholarship.name} — Status: ${appliedScholarship.applications[0].status}`
              : 'Eligible for Arts & STEM Fellowships — visit Scholarships to apply.'}
          </div>
        </ChartCard>
      </div>
    </div>
  )
}
