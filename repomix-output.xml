<file path="backend/prisma/seed.ts">
import { readFileSync } from 'node:fs'
import { resolve } from 'node:path'
import { PrismaClient } from '@prisma/client'

const prisma = new PrismaClient()

interface ChildSeed {
  id: string
  name: string
  age: number
  education: string
  health: string
  photo: string
}

interface MessageSeed {
  id: string
  from: string
  role: string
  text: string
  date: string
}

const readFrontendData = <T>(fileName: string): T => {
  const path = resolve(__dirname, '../../frontend/src/data', fileName)
  return JSON.parse(readFileSync(path, 'utf8')) as T
}

async function main() {
  const children = readFrontendData<ChildSeed[]>('children.json')
  const messages = readFrontendData<MessageSeed[]>('messages.json')

  for (const child of children) {
    await prisma.child.upsert({
      where: { id: child.id },
      update: child,
      create: child
    })
  }

  const donations = [
    { id: 'd1', donorName: 'R. Sharma', total: 1200 },
    { id: 'd2', donorName: 'Global Philanthropy', total: 4200 },
    { id: 'd3', donorName: 'Friends of Sahaaya', total: 2300 }
  ]

  for (const donation of donations) {
    await prisma.donation.upsert({
      where: { id: donation.id },
      update: donation,
      create: donation
    })
  }

  const resources = [
    { id: 'r1', name: 'Textbooks', stock: 120, lowThreshold: 20 },
    { id: 'r2', name: 'Laptops', stock: 12, lowThreshold: 3 },
    { id: 'r3', name: 'Uniforms', stock: 80, lowThreshold: 15 },
    { id: 'r4', name: 'Medicines', stock: 40, lowThreshold: 10 }
  ]

  for (const resource of resources) {
    await prisma.resource.upsert({
      where: { id: resource.id },
      update: resource,
      create: resource
    })
  }

  for (const message of messages) {
    const data = { ...message, date: new Date(message.date) }
    await prisma.message.upsert({
      where: { id: message.id },
      update: data,
      create: data
    })
  }
}

main()
  .catch((error: unknown) => {
    console.error('Database seed failed:', error)
    process.exitCode = 1
  })
  .finally(async () => {
    await prisma.$disconnect()
  })
</file>

<file path="backend/src/server.ts">
import { randomUUID } from 'node:crypto'
import cors from 'cors'
import dotenv from 'dotenv'
import express, { ErrorRequestHandler, RequestHandler } from 'express'
import { Prisma, PrismaClient } from '@prisma/client'

dotenv.config()

const app = express()
const prisma = new PrismaClient()
const port = Number(process.env.PORT) || 5000

app.use(cors())
app.use(express.json())

const asyncHandler = (handler: RequestHandler): RequestHandler =>
  (request, response, next) => {
    Promise.resolve(handler(request, response, next)).catch(next)
  }

const isNonEmptyString = (value: unknown): value is string =>
  typeof value === 'string' && value.trim().length > 0

app.get('/api/dashboard/stats', asyncHandler(async (_request, response) => {
  const [children, donations, resources, messages] = await Promise.all([
    prisma.child.count(),
    prisma.donation.aggregate({ _count: true, _sum: { total: true } }),
    prisma.resource.aggregate({ _count: true, _sum: { stock: true } }),
    prisma.message.count()
  ])

  response.json({
    children,
    donations: {
      count: donations._count,
      total: donations._sum.total ?? 0
    },
    resources: {
      count: resources._count,
      totalStock: resources._sum.stock ?? 0
    },
    messages
  })
}))

app.get('/api/children', asyncHandler(async (_request, response) => {
  const children = await prisma.child.findMany({ orderBy: { name: 'asc' } })
  response.json(children)
}))

app.post('/api/children', asyncHandler(async (request, response) => {
  const { id, name, age, education, health, photo } = request.body ?? {}

  if (
    (id !== undefined && !isNonEmptyString(id)) ||
    !isNonEmptyString(name) ||
    !Number.isInteger(age) ||
    age < 0 ||
    !isNonEmptyString(education) ||
    !isNonEmptyString(health) ||
    !isNonEmptyString(photo)
  ) {
    response.status(400).json({
      error: 'Expected name, non-negative integer age, education, health, and photo.'
    })
    return
  }

  const child = await prisma.child.create({
    data: {
      id: id ?? randomUUID(),
      name: name.trim(),
      age,
      education: education.trim(),
      health: health.trim(),
      photo: photo.trim()
    }
  })

  response.status(201).json(child)
}))

app.get('/api/resources/:id', asyncHandler(async (request, response) => {
  const resource = await prisma.resource.findUnique({
    where: { id: request.params.id }
  })

  if (!resource) {
    response.status(404).json({ error: 'Resource not found.' })
    return
  }

  response.json(resource)
}))

app.get('/api/messages', asyncHandler(async (_request, response) => {
  const messages = await prisma.message.findMany({ orderBy: { date: 'desc' } })
  response.json(messages)
}))

app.post('/api/messages', asyncHandler(async (request, response) => {
  const { id, from, role, text, date } = request.body ?? {}

  if (
    (id !== undefined && !isNonEmptyString(id)) ||
    !isNonEmptyString(from) ||
    !isNonEmptyString(role) ||
    !isNonEmptyString(text) ||
    (date !== undefined && (typeof date !== 'string' || Number.isNaN(Date.parse(date))))
  ) {
    response.status(400).json({
      error: 'Expected from, role, text, and an optional valid date.'
    })
    return
  }

  const message = await prisma.message.create({
    data: {
      id: id ?? randomUUID(),
      from: from.trim(),
      role: role.trim(),
      text: text.trim(),
      date: date === undefined ? new Date() : new Date(date)
    }
  })

  response.status(201).json(message)
}))

app.get('/api/health', (_request, response) => {
  response.json({ status: 'ok' })
})

const errorHandler: ErrorRequestHandler = (error: unknown, _request, response, _next) => {
  if (error instanceof SyntaxError && 'body' in error) {
    response.status(400).json({ error: 'Request body must contain valid JSON.' })
    return
  }

  if (
    error instanceof Prisma.PrismaClientKnownRequestError &&
    error.code === 'P2002'
  ) {
    response.status(409).json({ error: 'A record with that id already exists.' })
    return
  }

  console.error('API request failed:', error)
  response.status(500).json({ error: 'An unexpected server error occurred.' })
}

app.use(errorHandler)

const server = app.listen(port, () => {
  console.log(`Backend server listening on port ${port}`)
})

const shutdown = () => {
  server.close(() => {
    void prisma.$disconnect()
  })
}

process.on('SIGINT', shutdown)
process.on('SIGTERM', shutdown)
</file>

