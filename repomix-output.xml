  const handleApply = async (scholarshipId: string, e: React.FormEvent<HTMLFormElement>) => {
    e.preventDefault()
    const fd = new FormData(e.currentTarget)
    const statement = String(fd.get('statement') || '').trim()
    const childId = String(fd.get('childId') || '').trim() || undefined

    try {
      await applyForScholarship(scholarshipId, { childId, statement })
      setApplyingId(null)
      setFeedback('Scholarship application submitted.')
      await loadData()
    } catch (err: any) {
      setFeedback(err.message || 'Could not submit application.')
    }
  }

  const handleReview = async (
    applicationId: string,
    status: 'UNDER_REVIEW' | 'APPROVED' | 'REJECTED'
  ) => {
    try {
      await reviewScholarshipApplication(applicationId, status)
      setFeedback(`Application marked ${status.replace('_', ' ')}.`)
      await loadData()
    } catch (err: any) {
      setFeedback(err.message || 'Failed to update application.')
    }
  }

  return (
    <div className="space-y-6">
      <h2 className="text-2xl handwritten" style={{ color: '#6b4c3b' }}>
        Scholarships &amp; Career Hub
      </h2>

      {feedback && (
        <div className="glass-card rounded-lg px-4 py-2 text-sm handwritten" style={{ color: '#4b3628' }}>
          {feedback}
        </div>
      )}

      <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {scholarships.map((s) => (
          <Card key={s.id} className="p-4 flex flex-col justify-between">
            <div>
              <div className="handwritten font-semibold text-lg" style={{ color: '#4b3628' }}>
                {s.name}
              </div>
              <div className="text-xs mt-0.5" style={{ color: '#6b4c3b' }}>
                {s.provider} · ₹{s.amount.toLocaleString('en-IN')}
              </div>
              <div className="text-sm mt-2" style={{ color: '#5a4433' }}>
                Awarded: {s.awarded} · Applicants: {s.totalApplications}
              </div>
              <p className="text-xs mt-1" style={{ color: '#6b4c3b' }}>
                {s.eligibility}
              </p>
            </div>

            {canApply && (
              <div className="mt-3 pt-2 border-t border-[#6b4c3b]/10">
                <button
                  type="button"
                  onClick={() =>
                    setApplyingId((prev) => (prev === s.id ? null : s.id))
                  }
                  className="text-xs underline handwritten"
                  style={{ color: '#6b4c3b' }}
                >
                  {applyingId === s.id
                    ? 'Cancel'
                    : dbRole === 'STUDENT'
                      ? 'Apply Now →'
                      : 'Nominate Student →'}
                </button>

                {applyingId === s.id && (
                  <form onSubmit={(e) => handleApply(s.id, e)} className="mt-2 space-y-2 text-xs">
                    {isStaffReviewer && (
                      <select
                        name="childId"
                        required
                        className="w-full rounded border border-[#6b4c3b]/20 bg-[#fffdf7] p-1.5"
                      >
                        <option value="">Select student…</option>
                        {children.map((c) => (
                          <option key={c.id} value={c.id}>
                            {c.name} ({c.education})
                          </option>
                        ))}
                      </select>
                    )}
                    <textarea
                      name="statement"
                      rows={3}
                      minLength={10}
                      placeholder="Short statement of goals & academic progress…"
                      required
                      className="w-full rounded border border-[#6b4c3b]/20 bg-[#fffdf7] p-1.5"
                    />
                    <button type="submit" className="btn-primary handwritten w-full py-1">
                      Submit Application
                    </button>
                  </form>
                )}
              </div>
            )}

            {s.applications.length > 0 && (
              <div className="mt-3 pt-2 border-t border-[#6b4c3b]/10 space-y-1.5 text-xs">
                <div className="font-semibold handwritten" style={{ color: '#4b3628' }}>
                  {dbRole === 'STUDENT' ? 'Your Application' : 'Recent Applications'}
                </div>
                {s.applications.slice(0, 4).map((app) => (
                  <div key={app.id} className="flex items-center justify-between gap-2">
                    <span style={{ color: '#5a4433' }}>
                      {app.child.name} ({app.status})
                    </span>
                    {isStaffReviewer && app.status !== 'APPROVED' && (
                      <div className="flex gap-1">
                        <button
                          type="button"
                          onClick={() => void handleReview(app.id, 'APPROVED')}
                          className="rounded bg-[#2f6b4a] px-1.5 py-0.5 text-white"
                        >
                          Approve
                        </button>
                        <button
                          type="button"
                          onClick={() => void handleReview(app.id, 'REJECTED')}
                          className="rounded bg-[#8c5a2b] px-1.5 py-0.5 text-white"
                        >
                          Reject
                        </button>
                      </div>
                    )}
                  </div>
                ))}
              </div>
            )}
          </Card>
        ))}
      </div>
    </div>
  )
}
</file>

