import React, { useEffect, useState } from 'react'
import Card from '../components/Card'
import {
  ResourceItem,
  createResource,
  getResources,
  recordStockMovement,
} from '../api/client'
import { useRole } from '../contexts/RoleContext'

export default function Resources() {
  const { dbRole } = useRole()
  const canManageStock = dbRole === 'SUPER_ADMIN' || dbRole === 'STAFF'

  const [resources, setResources] = useState<ResourceItem[]>([])
  const [lowStockOnly, setLowStockOnly] = useState(false)
  const [showNewForm, setShowNewForm] = useState(false)
  const [activeMovementId, setActiveMovementId] = useState<string | null>(null)
  const [error, setError] = useState('')

  const loadResources = async (onlyLow = lowStockOnly) => {
    try {
      const list = await getResources({ lowStock: onlyLow })
      setResources(list)
      setError('')
    } catch (err: any) {
      setError(err.message || 'Unable to load inventory.')
    }
  }

  useEffect(() => {
    void loadResources(lowStockOnly)
  }, [lowStockOnly])

  const handleCreateResource = async (e: React.FormEvent<HTMLFormElement>) => {
    e.preventDefault()
    const fd = new FormData(e.currentTarget)
    try {
      await createResource({
        name: String(fd.get('name') || ''),
        category: String(fd.get('category') || 'Essentials'),
        unit: String(fd.get('unit') || 'units'),
        stock: Number(fd.get('stock') || 0),
        lowThreshold: Number(fd.get('lowThreshold') || 10),
      })
      e.currentTarget.reset()
      setShowNewForm(false)
      await loadResources()
    } catch (err: any) {
      setError(err.message || 'Could not add inventory item.')
    }
  }

  const handleMovement = async (
    resourceId: string,
    e: React.FormEvent<HTMLFormElement>
  ) => {
    e.preventDefault()
    const fd = new FormData(e.currentTarget)
    try {
      await recordStockMovement(resourceId, {
        type: String(fd.get('type')) as 'INCOMING' | 'OUTGOING' | 'ADJUSTMENT',
        quantity: Number(fd.get('quantity') || 1),
        reason: String(fd.get('reason') || ''),
      })
      setActiveMovementId(null)
      setError('')
      await loadResources()
    } catch (err: any) {
      setError(err.message || 'Stock movement failed.')
    }
  }

  return (
    <div className="space-y-6">
      <div className="flex flex-wrap items-center justify-between gap-3">
        <h2 className="text-2xl handwritten" style={{ color: '#6b4c3b' }}>
          Resources &amp; Inventory
        </h2>
        <div className="flex items-center gap-3">
          <label className="flex items-center gap-1.5 text-sm handwritten" style={{ color: '#4b3628' }}>
            <input
              type="checkbox"
              checked={lowStockOnly}
              onChange={(e) => setLowStockOnly(e.target.checked)}
            />
            Low stock only
          </label>
          {canManageStock && (
            <button
              type="button"
              onClick={() => setShowNewForm((s) => !s)}
              className="btn-primary handwritten text-sm"
            >
              {showNewForm ? 'Close' : '+ Add Item'}
            </button>
          )}
        </div>
      </div>

      {error && (
        <div className="rounded-lg border border-red-800/20 bg-red-50 px-4 py-2 text-sm text-red-900">
          {error}
        </div>
      )}

      {canManageStock && showNewForm && (
        <Card className="p-4">
          <form onSubmit={handleCreateResource} className="grid grid-cols-1 sm:grid-cols-5 gap-3 text-sm">
            <input
              name="name"
              placeholder="Item name"
              required
              className="rounded-lg border border-[#6b4c3b]/20 bg-[#fffdf7] p-2"
            />
            <input
              name="category"
              placeholder="Category (Education/Health)"
              defaultValue="Essentials"
              required
              className="rounded-lg border border-[#6b4c3b]/20 bg-[#fffdf7] p-2"
            />
            <input
              name="stock"
              type="number"
              min="0"
              placeholder="Initial stock"
              required
              className="rounded-lg border border-[#6b4c3b]/20 bg-[#fffdf7] p-2"
            />
            <input
              name="lowThreshold"
              type="number"
              min="0"
              defaultValue={15}
              placeholder="Low alert threshold"
              required
              className="rounded-lg border border-[#6b4c3b]/20 bg-[#fffdf7] p-2"
            />
            <button type="submit" className="btn-primary handwritten">
              Save Item
            </button>
          </form>
        </Card>
      )}

      <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {resources.map((r) => (
          <Card key={r.id} className="p-4">
            <div className="flex items-start justify-between gap-2">
              <div>
                <div className="handwritten font-semibold text-lg" style={{ color: '#4b3628' }}>
                  {r.name}
                </div>
                <div className="text-xs" style={{ color: '#6b4c3b' }}>
                  {r.category}
                </div>
              </div>
              {r.isLowStock && (
                <span className="vintage-badge text-xs font-semibold text-amber-900">
                  Low Stock
                </span>
              )}
            </div>

            <div className="mt-3 text-sm" style={{ color: '#5a4433' }}>
              In Stock: <span className="font-bold">{r.stock}</span> {r.unit} (Alert ≤{' '}
              {r.lowThreshold})
            </div>

            {canManageStock && (
              <div className="mt-3">
                <button
                  type="button"
                  onClick={() =>
                    setActiveMovementId((prev) => (prev === r.id ? null : r.id))
                  }
                  className="text-xs underline handwritten"
                  style={{ color: '#6b4c3b' }}
                >
                  {activeMovementId === r.id ? 'Cancel' : 'Record Stock In / Out →'}
                </button>

                {activeMovementId === r.id && (
                  <form
                    onSubmit={(e) => handleMovement(r.id, e)}
                    className="mt-2 space-y-2 border-t border-[#6b4c3b]/10 pt-2 text-xs"
                  >
                    <div className="flex gap-2">
                      <select
                        name="type"
                        className="rounded border border-[#6b4c3b]/20 bg-[#fffdf7] p-1"
                      >
                        <option value="INCOMING">INCOMING (+)</option>
                        <option value="OUTGOING">OUTGOING (-)</option>
                        <option value="ADJUSTMENT">SET COUNT (=)</option>
                      </select>
                      <input
                        name="quantity"
                        type="number"
                        min="1"
                        defaultValue={5}
                        required
                        className="w-20 rounded border border-[#6b4c3b]/20 bg-[#fffdf7] p-1"
                      />
                    </div>
                    <input
                      name="reason"
                      placeholder="Reason (e.g. Distributed to Grade 5)"
                      required
                      className="w-full rounded border border-[#6b4c3b]/20 bg-[#fffdf7] p-1.5"
                    />
                    <button type="submit" className="btn-primary handwritten w-full py-1">
                      Update Stock
                    </button>
                  </form>
                )}
              </div>
            )}
          </Card>
        ))}
      </div>
    </div>
  )
}
