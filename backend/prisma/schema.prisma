generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  SUPER_ADMIN
  STAFF
  EDUCATOR
  HEALTHCARE_STAFF
  DONOR
  STUDENT
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum MovementType {
  INCOMING
  OUTGOING
  ADJUSTMENT
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  city      String
  state     String
  address   String?
  phone     String?
  email     String?
  isDemo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users        User[]
  children     Child[]
  campaigns    Campaign[]
  donations    Donation[]
  resources    Resource[]
  scholarships Scholarship[]
  mentors      Mentor[]
  auditLogs    AuditLog[]
}

model User {
  id             String       @id @default(uuid())
  authId         String?      @unique
  email          String       @unique
  name           String
  role           UserRole
  phone          String?
  avatarUrl      String?
  isDemo         Boolean      @default(true)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  donorProfile      Donor?
  mentorProfile     Mentor?
  studentChild      Child?              @relation("StudentUser")
  assignedChildren  Child[]             @relation("AssignedStaff")
  educationRecords  EducationRecord[]   @relation("EducatorRecords")
  healthRecords     HealthRecord[]      @relation("HealthcareRecords")
  stockMovements    StockMovement[]
  sentMessages      Message[]           @relation("SentMessages")
  uploadedDocuments Document[]
  auditLogs         AuditLog[]
}

model Child {
  id               String       @id @default(uuid())
  code             String       @unique
  name             String
  age              Int
  dateOfBirth      DateTime
  gender           String
  admissionDate    DateTime
  educationSummary String
  healthSummary    String
  photo            String
  bio              String?
  isArchived       Boolean      @default(false)
  isDemo           Boolean      @default(true)
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  studentUserId    String?      @unique
  studentUser      User?        @relation("StudentUser", fields: [studentUserId], references: [id], onDelete: SetNull)
  assignedStaffId  String?
  assignedStaff    User?        @relation("AssignedStaff", fields: [assignedStaffId], references: [id], onDelete: SetNull)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  educationRecords        EducationRecord[]
  attendanceRecords       Attendance[]
  healthRecords           HealthRecord[]
  scholarshipApplications ScholarshipApplication[]
  mentorshipSessions      MentorshipSession[]
  documents               Document[]
}

model EducationRecord {
  id           String   @id @default(uuid())
  childId      String
  child        Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  educatorId   String?
  educator     User?    @relation("EducatorRecords", fields: [educatorId], references: [id], onDelete: SetNull)
  schoolName   String
  grade        String
  academicYear String
  term         String
  gpaOrScore   Float
  notes        String?
  isDemo       Boolean  @default(true)
  createdAt    DateTime @default(now())

  attendances Attendance[]
}

model Attendance {
  id                String           @id @default(uuid())
  childId           String
  child             Child            @relation(fields: [childId], references: [id], onDelete: Cascade)
  educationRecordId String?
  educationRecord   EducationRecord? @relation(fields: [educationRecordId], references: [id], onDelete: SetNull)
  date              DateTime
  status            AttendanceStatus
  remarks           String?
  isDemo            Boolean          @default(true)
}

model HealthRecord {
  id                String    @id @default(uuid())
  childId           String
  child             Child     @relation(fields: [childId], references: [id], onDelete: Cascade)
  healthcareStaffId String?
  healthcareStaff   User?     @relation("HealthcareRecords", fields: [healthcareStaffId], references: [id], onDelete: SetNull)
  checkupDate       DateTime
  heightCm          Float?
  weightKg          Float?
  immunizationNotes String?
  diagnosisOrNotes  String
  followUpDate      DateTime?
  isDemo            Boolean   @default(true)
  createdAt         DateTime  @default(now())
}

model Donor {
  id          String   @id @default(uuid())
  userId      String?  @unique
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  name        String
  email       String   @unique
  phone       String?
  city        String?
  isRecurring Boolean  @default(false)
  isAnonymous Boolean  @default(false)
  isDemo      Boolean  @default(true)
  createdAt   DateTime @default(now())

  donations Donation[]
}

model Campaign {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title          String
  description    String
  targetAmount   Float
  raisedAmount   Float        @default(0)
  isActive       Boolean      @default(true)
  isDemo         Boolean      @default(true)
  createdAt      DateTime     @default(now())

  donations Donation[]
}

model Donation {
  id             String        @id @default(uuid())
  donorId        String
  donor          Donor         @relation(fields: [donorId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaignId     String?
  campaign       Campaign?     @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  amount         Float
  currency       String        @default("INR")
  status         PaymentStatus @default(COMPLETED)
  paymentRef     String?       @unique
  donatedAt      DateTime      @default(now())
  isDemo         Boolean       @default(true)
}

model Resource {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  category       String
  unit           String
  stock          Int
  lowThreshold   Int
  isDemo         Boolean      @default(true)
  updatedAt      DateTime     @updatedAt

  movements StockMovement[]
}

model StockMovement {
  id            String       @id @default(uuid())
  resourceId    String
  resource      Resource     @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  performedById String?
  performedBy   User?        @relation(fields: [performedById], references: [id], onDelete: SetNull)
  type          MovementType
  quantity      Int
  reason        String
  createdAt     DateTime     @default(now())
  isDemo        Boolean      @default(true)
}

model Scholarship {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title          String
  provider       String
  amount         Float
  eligibility    String
  deadline       DateTime
  isActive       Boolean      @default(true)
  isDemo         Boolean      @default(true)

  applications ScholarshipApplication[]
}

model ScholarshipApplication {
  id            String            @id @default(uuid())
  scholarshipId String
  scholarship   Scholarship       @relation(fields: [scholarshipId], references: [id], onDelete: Cascade)
  childId       String
  child         Child             @relation(fields: [childId], references: [id], onDelete: Cascade)
  status        ApplicationStatus @default(SUBMITTED)
  statement     String?
  appliedAt     DateTime          @default(now())
  isDemo        Boolean           @default(true)
}

model Mentor {
  id             String       @id @default(uuid())
  userId         String?      @unique
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  specialty      String
  bio            String?
  city           String?
  isActive       Boolean      @default(true)
  isDemo         Boolean      @default(true)

  sessions MentorshipSession[]
}

model MentorshipSession {
  id          String   @id @default(uuid())
  mentorId    String
  mentor      Mentor   @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  childId     String
  child       Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  topic       String
  sessionDate DateTime
  durationMin Int
  notes       String?
  isDemo      Boolean  @default(true)
}

model Message {
  id           String   @id @default(uuid())
  senderId     String?
  sender       User?    @relation("SentMessages", fields: [senderId], references: [id], onDelete: SetNull)
  fromName     String
  fromRole     String
  text         String
  isPublicWall Boolean  @default(true)
  createdAt    DateTime @default(now())
  isDemo       Boolean  @default(true)
}

model Document {
  id           String   @id @default(uuid())
  childId      String?
  child        Child?   @relation(fields: [childId], references: [id], onDelete: Cascade)
  uploadedById String?
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  title        String
  category     String
  storagePath  String
  isConsented  Boolean  @default(false)
  isDemo       Boolean  @default(true)
  createdAt    DateTime @default(now())
}

model AuditLog {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actorId        String?
  actor          User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action         String
  entityType     String
  entityId       String
  metadata       Json?
  createdAt      DateTime     @default(now())
}